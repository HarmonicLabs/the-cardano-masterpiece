# Copy to `.env.local` (git-ignored) and fill in for LOCAL dev.
# All optional & server-side only — the browser never sees these. On Vercel,
# set them in Project → Settings → Environment Variables instead.
# Loaded by api/_env.ts for `npm run dev` and `npm start`.

# --- Blockfrost (chain access via the /bf proxy) ---
# Defaults to the public preprod proxy when unset. Set either of these to use
# your own endpoint / a real blockfrost.io key.
# BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
# BLOCKFROST_PROJECT_ID=preprod_your_project_id_here

# --- Filebase (IPFS pinning for /api/publish) ---
# S3 access keys from the Filebase dashboard + an IPFS bucket you created.
# Free tier (5 GB) covers the single ~1 MB committed image.
# FILEBASE_KEY=...
# FILEBASE_SECRET=...
# FILEBASE_BUCKET=my-masterpiece-bucket
